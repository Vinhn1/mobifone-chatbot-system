# ============================================================
# Git Ignore — MobiFone Chatbot System (Monorepo)
# ============================================================

# ─── Environment Variables (NEVER commit secrets) ───────────
.env
.env.*
!.env.example

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.pyc

# ─── Node.js ────────────────────────────────────────────────
node_modules/
.npm
dist/
.next/
out/
build/
*.local

# ─── TypeScript build cache ──────────────────────────────────
*.tsbuildinfo

# ─── Databases & Vector Stores ──────────────────────────────
.chroma/
chroma.db
ai-core/chroma_db/
**/chroma_db/
faiss_index/

# ─── Log files ──────────────────────────────────────────────
*.log
logs/
backend/start.log

# ─── Temporary / Scratch files ───────────────────────────────
temp_*/
temp_*.py
temp_*.txt
**/temp_uploads/
frontend/temp_*.txt
ai-core/out.txt
ai-core/test_output.txt
ai-core/esim_search_results.txt

# ─── Eval / Test output files & scripts ─────────────────────
ai-core/eval_dataset_100.json
ai-core/dynamic_suggestions.json
ai-core/eval_accuracy_report.json
ai-core/eval_accuracy_report.md
ai-core/eval_accuracy.py
ai-core/generate_eval_dataset.py
ai-core/run_eval_ci.py
ai-core/run_eval_ci.bat
ai-core/sales_benchmark.py
ai-core/sales_metrics.py
ai-core/validate_final.py
ai-core/validate_wifi_packages.py
ai-core/reports/
ai-core/data/sales_metrics.jsonl

# ─── Browser automation profiles ────────────────────────────
ai-core/browser_profiles/

# ─── Data pipeline raw/processed data ───────────────────────
**/data/raw/
**/data/processed/
**/data/*.json
**/data/*.csv
# Exception: config files in data/ phải được track (không phải raw/generated data)
!ai-core/data/wifi_packages.json
!ai-core/data/wifi_playbooks.json
crawl_summary.json

# ─── Zalo verifier files (temporary, backend serves them) ────
*zalo_verifier*.html

# ─── IDEs & OS ──────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ─── AI Agent Configuration (AG Kit / Claude) ───────────────
.agent/
.agents/
agent-skills/
.claude/
.claude-plugin/
.gemini/
.opencode/

# ─── Docs directory (exclude from repo — served separately) ──
docs/

# ─── Data pipeline runs ──────────────────────────────────────
mobifone-rag-data-pipeline/logs/
mobifone-rag-data-pipeline/__pycache__/