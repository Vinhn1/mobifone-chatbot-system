# ============================================================
# MobiFone Chatbot System — Environment Variables Template
# Sao chép file này thành .env và điền các giá trị thực
# cp .env.example .env
# ============================================================

# ─── Cơ sở dữ liệu PostgreSQL ─────────────────────────────
DB_HOST=db                        # Giữ nguyên khi dùng Docker Compose
DB_PORT=5432
DB_USERNAME=mobifone_user
DB_PASSWORD=THAY_BANG_MAT_KHAU_MANH
DB_DATABASE=mobifone_db
DB_SYNCHRONIZE=true               # ← Đổi thành false sau lần chạy đầu!

# ─── Authentication JWT ───────────────────────────────────
# Tạo bằng: openssl rand -hex 64
JWT_SECRET=THAY_BANG_CHUOI_64_KY_TU_NGAU_NHIEN
JWT_EXPIRES_IN=1d

# ─── AI Core — Google Gemini (Bắt buộc) ──────────────────
# Lấy tại: https://aistudio.google.com
GEMINI_API_KEY=THAY_BANG_GEMINI_API_KEY
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── OpenAI (Tùy chọn — dùng cho evaluation) ─────────────
OPENAI_API_KEY=THAY_BANG_OPENAI_KEY
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini

# ─── Email SMTP (Gmail) ───────────────────────────────────
# Xem hướng dẫn lấy App Password: docs/DEPLOYMENT_GUIDE.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx     # 16-char App Password (bỏ khoảng trắng)
SMTP_FROM="MobiFone Chatbot <your_email@gmail.com>"

# ─── CORS ─────────────────────────────────────────────────
# Local dev: http://localhost:5173,http://localhost:8080
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Tài khoản mặc định khi khởi tạo lần đầu ─────────────
ADMIN_SEED_PASSWORD=Admin@123456
SALES_SEED_PASSWORD=Sales@123456
SUBSCRIBER_SEED_PASSWORD=Sub@123456

# ─── Facebook Messenger (Tùy chọn) ───────────────────────
# Xem hướng dẫn: docs/DEPLOYMENT_GUIDE.md
# FACEBOOK_VERIFY_TOKEN=your_verify_token
# FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxx...
# FACEBOOK_PAGE_ID=12345678901234

# ─── Zalo Official Account (Tùy chọn) ────────────────────
# Xem hướng dẫn: docs/DEPLOYMENT_GUIDE.md
# ZALO_APP_ID=your_zalo_app_id
# ZALO_OA_ID=your_zalo_oa_id
# ZALO_APP_SECRET_KEY=your_secret_key
# ZALO_ACCESS_TOKEN=your_access_token
# ZALO_REFRESH_TOKEN=your_refresh_token
